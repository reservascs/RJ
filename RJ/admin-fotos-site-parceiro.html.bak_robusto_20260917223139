<!DOCTYPE html>
<html lang="pt-BR">
<head>
<!-- Painel local; autenticação futura deve ser implementada no backend. -->
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin de Fotos — Site Parceiro</title>
<style>
  :root{--verde:#1f4d3a;--verde-esc:#12302a;--dourado:#c69a4e;--areia:#f6f2e9;--borda:#e4ddcd;--txt:#1c211d;--suave:#6b6a5f;--branco:#fffdf9}
  *{box-sizing:border-box}
  body{margin:0;font-family:system-ui,Segoe UI,Roboto,sans-serif;color:var(--txt);background:var(--areia)}
  header{background:var(--verde-esc);color:#fff;padding:10px 20px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
  header .logo{height:58px;width:auto;display:block;object-fit:contain;background:#fff;padding:4px 8px;border-radius:4px}
  header .head-info{display:flex;flex-direction:column;gap:3px}
  header h1{font-size:17px;margin:0;font-weight:600}
  header .tag{font-size:12px;opacity:.8}
  .wrap{max-width:1000px;margin:0 auto;padding:20px}
  button{font:inherit;cursor:pointer;border:1px solid var(--borda);background:#fff;border-radius:8px;padding:8px 14px}
  button.primary{background:var(--verde);color:#fff;border-color:var(--verde)}
  button.primary:disabled{opacity:.5;cursor:default}
  button.gold{background:var(--dourado);color:#1c211d;border-color:var(--dourado)}
  button.danger{color:#a11;border-color:#e6c9c9}
  select{font:inherit;padding:8px;border-radius:8px;border:1px solid var(--borda);background:#fff;min-width:240px}
  .row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
  .card{background:#fff;border:1px solid var(--borda);border-radius:12px;padding:16px;margin-bottom:16px}
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
  .foto{border:1px solid var(--borda);border-radius:10px;overflow:hidden;background:#faf8f2;position:relative;display:flex;flex-direction:column}
  .foto.capa{outline:3px solid var(--dourado)}
  .foto.apagar{opacity:.4}
  .foto .thumb{width:100%;aspect-ratio:4/3;object-fit:cover;background:#eee;display:block}
  .foto .miss{width:100%;aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--suave);text-align:center;padding:6px}
  .foto .acoes{display:flex;gap:4px;padding:6px;flex-wrap:wrap;border-top:1px solid var(--borda)}
  .foto .acoes button{padding:4px 7px;font-size:12px;border-radius:6px}
  .badge{position:absolute;top:6px;left:6px;background:var(--dourado);color:#1c211d;font-size:11px;font-weight:700;padding:2px 7px;border-radius:20px}
  .nome{font-size:11px;color:var(--suave);padding:4px 6px 0;word-break:break-all}
  .status{font-size:13px;color:var(--suave);margin-left:auto}
  .aviso{background:#fff8e6;border:1px solid #ecd9a6;border-radius:8px;padding:10px 12px;font-size:13px;margin-bottom:14px}
  .log{white-space:pre-wrap;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;background:#12302a;color:#d9ead9;border-radius:8px;padding:12px;max-height:220px;overflow:auto;margin-top:12px}
  a{color:var(--verde)}
</style>
</head>
<body>
<header>
  <img class="logo" src="bx.png" alt="Brazil Excursions">
  <div class="head-info">
    <h1>Admin de Fotos — Site Parceiro</h1>
    <span class="tag">edição local do site parceiro — pronto para futura autenticação</span>
  </div>
</header>
<div class="wrap">

  <div class="aviso" id="aviso-compat" hidden>
    Seu navegador não permite editar arquivos direto. Use <b>Edge</b> ou <b>Chrome</b> no computador.
  </div>

  <div class="card">
    <div class="row">
      <button class="primary" id="btn-abrir">Abrir</button>
      <span class="status" id="pasta-status">Nenhum site aberto</span>
    </div>
    <div class="row" id="linha-passeio" hidden>
      <label>Passeio:</label>
      <select id="sel-passeio"></select>
      <input type="file" id="add-input" accept="image/*" multiple hidden>
      <button id="btn-add">+ Adicionar fotos</button>
      <span class="status" id="contagem"></span>
    </div>
  </div>

  <div class="card" id="painel" hidden>
    <div class="row">
      <strong id="titulo-passeio"></strong>
      <button class="primary" id="btn-salvar" style="margin-left:auto" disabled>Salvar no site parceiro</button>
    </div>
    <div class="row" style="margin:0 0 6px;gap:8px">
      <label style="font-weight:600">Vídeo YouTube:</label>
      <input id="video-input" placeholder="cole o link do YouTube (vazio = sem vídeo)" style="flex:1;min-width:240px;padding:8px;border:1px solid var(--borda);border-radius:8px">
      <a id="video-link" href="#" target="_blank" style="font-size:13px" hidden>abrir ▶</a>
    </div>
    <div class="row" style="margin:0 0 12px;gap:8px">
      <label style="font-weight:600">ou vídeo do PC:</label>
      <input type="file" id="vid-input" accept="video/mp4,video/quicktime" hidden>
      <button id="btn-vid">+ Enviar mp4 curto</button>
      <span class="status" id="vid-status" style="margin-left:0"></span>
    </div>
    <p style="font-size:13px;color:var(--suave);margin:0 0 12px">A <b>1ª foto</b> (marcada <span style="color:var(--dourado);font-weight:700">CAPA</span>) é o hero. Use ⭐ pra definir capa, ←/→ pra reordenar, 🗑 pra marcar/desmarcar remoção. Nada é gravado até clicar em <b>Salvar</b>.</p>
    <div class="grid" id="grid"></div>
  </div>

  <div class="log" id="log" hidden></div>
</div>

<script src="https://unpkg.com/@ffmpeg/ffmpeg@0.11.6/dist/ffmpeg.min.js"></script>
<script>
const MAXPX=1920, MAXKB=900, Q0=0.82, QMIN=0.6;
let siteDir=null;              // handle da pasta independente do site parceiro
const sites=[];                 // [{nome, dir}]
let passeios=[];                // [{id, titulo}]
let atual=null;                 // id selecionado
let itens=[];                   // [{path, nome, tipo:'local'|'url', url, novaBlob?, apagar:bool}]

const $=s=>document.querySelector(s);
function log(m){const el=$('#log');el.hidden=false;el.textContent+=m+"\n";el.scrollTop=el.scrollHeight;}

if(!window.showDirectoryPicker){ $('#aviso-compat').hidden=false; $('#btn-abrir').disabled=true; }
$('#video-input').addEventListener('input', atualizaVideoLink);
let vidLocal=null, vidAtualLocal=null;
$('#btn-vid').onclick=()=>$('#vid-input').click();
$('#vid-input').onchange=async(e)=>{ const f=e.target.files[0]; if(!f) return;
  if(!atual){ alert('Selecione um passeio primeiro.'); e.target.value=''; return; }
  e.target.value='';
  const mb0=f.size/1048576;
  $('#vid-status').textContent='otimizando video ('+mb0.toFixed(1)+' MB)… aguarde';
  let blob=f;
  try{ blob=await comprimirVideo(f); }
  catch(err){ $('#vid-status').textContent='⚠ nao consegui otimizar ('+err.message+') — usando original'; blob=f; }
  const mb=blob.size/1048576;
  vidLocal={nome:(atual+'-video.mp4'), blob:blob};
  $('#video-input').value=''; atualizaVideoLink();
  const aviso = mb>24 ? ' ⚠ ainda acima de 24MB' : '';
  const otim = (blob!==f) ? (' (otimizado de '+mb0.toFixed(1)+' MB)') : '';
  $('#vid-status').textContent='pronto: '+mb.toFixed(1)+' MB'+otim+aviso;
};
let _ffmpeg=null;
async function carregarFFmpeg(){
  if(_ffmpeg) return _ffmpeg;
  if(!window.FFmpeg) throw new Error('lib nao carregou (sem internet?)');
  const { createFFmpeg } = window.FFmpeg;
  const ff = createFFmpeg({ log:false, corePath:'https://unpkg.com/@ffmpeg/core@0.11.0/dist/ffmpeg-core.js' });
  await ff.load();
  _ffmpeg = ff; return ff;
}
async function comprimirVideo(file){
  const ff = await carregarFFmpeg();
  const { fetchFile } = window.FFmpeg;
  ff.setProgress(({ratio})=>{ if(ratio>=0&&ratio<=1) $('#vid-status').textContent='otimizando video… '+Math.round(ratio*100)+'%'; });
  const inName='in_'+Date.now()+'.mp4', outName='out.mp4';
  ff.FS('writeFile', inName, await fetchFile(file));
  await ff.run('-i',inName,'-vf','scale=trunc(min(1280\,iw)/2)*2:-2','-c:v','libx264','-crf','28','-preset','veryfast','-movflags','+faststart','-c:a','aac','-b:a','96k',outName);
  const data=ff.FS('readFile',outName);
  try{ ff.FS('unlink',inName); ff.FS('unlink',outName); }catch(_){}
  return new Blob([data.buffer], {type:'video/mp4'});
}

$('#btn-abrir').onclick=async()=>{
  try{
    siteDir=await window.showDirectoryPicker({mode:'readwrite'});
  }catch(e){ return; }
  // permissao readwrite
  if((await siteDir.requestPermission({mode:'readwrite'}))!=='granted'){ alert('Preciso de permissão de escrita na pasta.'); return; }
  sites.length=0;
  sites.push({nome:'site-parceiro', dir:siteDir});
  $('#pasta-status').textContent='Site aberto: '+siteDir.name;
  await carregarPasseios();
};

async function lerTexto(dir,nome){ const fh=await dir.getFileHandle(nome); const f=await fh.getFile(); return await f.text(); }
async function escreverTexto(dir,nome,txt){ const fh=await dir.getFileHandle(nome,{create:true}); const w=await fh.createWritable(); await w.write(txt); await w.close(); }

function nomePasseioExibicao(titulo){
  const t=String(titulo||'');
  return /g[aá]vea/i.test(t) ? 'Gávea' : t;
}
function pastaPasseio(id){
  return id==='trilha-pedra-da-gavea' ? 'gavea' : id;
}
// --- extrai passeios (id + titulo.pt) do data.js do site parceiro ---
function extrairPasseios(js){
  const out=[]; const re=/"id":\s*"([^"]+)"/g; let m;
  while((m=re.exec(js))){
    const id=m[1];
    // titulo.pt logo apos (heuristica): procura 'pt:' na janela seguinte
    const jan=js.slice(m.index, m.index+600);
    const t=jan.match(/["']?pt["']?\s*:\s*["']([^"']+)["']/);
    out.push({id, titulo:nomePasseioExibicao(t?t[1]:id)});
  }
  return out;
}
// --- pega o array imagens de um id ---
function getImagens(js,id){
  const k='"id": "'+id+'"'; let i=js.indexOf(k);
  if(i<0){ i=js.indexOf('"id":"'+id+'"'); }
  if(i<0) return null;
  const j=js.indexOf('"imagens"',i); if(j<0) return null;
  const a=js.indexOf('[',j), b=js.indexOf(']',a);
  const bloco=js.slice(a+1,b);
  const arr=[...bloco.matchAll(/"([^"]+)"/g)].map(x=>x[1]);
  return {a,b,arr};
}
// --- reescreve o array imagens de um id ---
function setImagens(js,id,lista){
  const g=getImagens(js,id); if(!g) return js;
  const corpo="\n"+lista.map(c=>'      "'+c+'"').join(",\n")+"\n    ";
  return js.slice(0,g.a+1)+corpo+js.slice(g.b);
}
// --- video YouTube ---
function ytId(u){ if(!u) return ''; u=u.trim();
  if(/^[A-Za-z0-9_-]{6,15}$/.test(u)) return u;
  const m=u.match(/(?:v=|youtu\.be\/|shorts\/|embed\/)([A-Za-z0-9_-]{6,15})/);
  return m?m[1]:''; }
function getVideos(js,id){
  let i=js.indexOf('"id": "'+id+'"'); if(i<0)i=js.indexOf('"id":"'+id+'"'); if(i<0)return null;
  const j=js.indexOf('"videos"',i); if(j<0)return null;
  const nx=js.indexOf('"id":',i+5); if(nx>0&&j>nx)return null;   // videos de outro registro
  const a=js.indexOf('[',j), b=js.indexOf(']',a);
  return {a,b,arr:[...js.slice(a+1,b).matchAll(/"([^"]+)"/g)].map(x=>x[1])};
}
function setVideos(js,id,lista){
  const val = (lista&&lista.length) ? '['+lista.map(x=>'"'+x+'"').join(', ')+']' : '[]';
  const g=getVideos(js,id);
  if(g){ return js.slice(0,g.a)+val+js.slice(g.b+1); }
  let i=js.indexOf('"id": "'+id+'"'); if(i<0)i=js.indexOf('"id":"'+id+'"'); if(i<0)return js;
  const eol=js.indexOf('\n',i);
  return js.slice(0,eol+1)+'    "videos": '+val+',\n'+js.slice(eol+1);
}
function atualizaVideoLink(){
  const yt=ytId($('#video-input').value); const a=$('#video-link');
  if(yt){ a.hidden=false; a.href='https://www.youtube.com/watch?v='+yt; } else { a.hidden=true; }
}

async function carregarPasseios(){
  let js;
  try{ js=await lerTexto(siteDir,'data.js'); }
  catch(e){ log('ERRO: não achei data.js na pasta "'+siteDir.name+'". Você precisa escolher a pasta do site parceiro (a que tem data.js). Detalhe: '+e.message); return; }
  log('data.js lido: '+js.length+' caracteres, da pasta "'+siteDir.name+'"');
  passeios=extrairPasseios(js);
  log('Passeios encontrados: '+passeios.length);
  const sel=$('#sel-passeio'); sel.innerHTML='<option value="">— escolha —</option>'+
    passeios.map(p=>'<option value="'+p.id+'">'+p.titulo+'  ('+p.id+')</option>').join('');
  $('#linha-passeio').hidden=false;
  sel.onchange=()=>selecionar(sel.value);
  if(!passeios.length) log('Nenhum passeio casou. Início do arquivo: '+JSON.stringify(js.slice(0,100)));
}

async function dirPasseio(site,id,create){
  try{
    const a=await site.dir.getDirectoryHandle('assets');
    const p=await a.getDirectoryHandle('passeios');
    return await p.getDirectoryHandle(pastaPasseio(id),{create:!!create});
  }catch(e){ return null; }
}

async function selecionar(id){
  atual=id; itens=[]; $('#painel').hidden=true; $('#log').hidden=true; $('#log').textContent='';
  if(!id) return;
  const js=await lerTexto(siteDir,'data.js');
  const g=getImagens(js,id);
  const arr=g?g.arr:[];
  // monta itens; thumb para locais
  for(const path of arr){
    const it={path, nome:path.split('/').pop(), tipo:path.startsWith('assets/')?'local':'url', url:path, apagar:false, novaBlob:null};
    if(it.tipo==='local'){
      try{
        const d=await dirPasseio(sites[0],id,false);
        const fh=await d.getFileHandle(it.nome); const f=await fh.getFile();
        it.url=URL.createObjectURL(f);
      }catch(e){ it.url=null; }
    }
    itens.push(it);
  }
  vidLocal=null; vidAtualLocal=null; $('#vid-status').textContent='';
  const gv=getVideos(js,id); const cur=gv&&gv.arr[0] ? gv.arr[0] : '';
  if(cur.startsWith('assets/')){ vidAtualLocal=cur; $('#video-input').value=''; $('#vid-status').textContent='vídeo atual: '+cur.split('/').pop(); }
  else { $('#video-input').value = cur ? (ytId(cur)||cur) : ''; }
  atualizaVideoLink();
  $('#titulo-passeio').textContent=passeios.find(p=>p.id===id)?.titulo+'  ·  '+id;
  render();
  $('#painel').hidden=false;
}

function render(){
  const grid=$('#grid'); grid.innerHTML='';
  itens.forEach((it,idx)=>{
    const div=document.createElement('div');
    div.className='foto'+(idx===0?' capa':'')+(it.apagar?' apagar':'');
    const thumb = it.url ? '<img class="thumb" src="'+it.url+'" alt="">' : '<div class="miss">sem preview<br>'+(it.tipo==='url'?'(link externo)':'')+'</div>';
    div.innerHTML =
      (idx===0?'<span class="badge">CAPA</span>':'')+
      thumb+
      '<div class="nome">'+it.nome+(it.novaBlob?' (nova)':'')+'</div>'+
      '<div class="acoes">'+
        '<button title="Definir como capa" data-a="capa" data-i="'+idx+'">⭐</button>'+
        '<button title="Mover p/ esquerda" data-a="esq" data-i="'+idx+'">←</button>'+
        '<button title="Mover p/ direita" data-a="dir" data-i="'+idx+'">→</button>'+
        '<button class="danger" title="Marcar remoção" data-a="del" data-i="'+idx+'">🗑</button>'+
      '</div>';
    grid.appendChild(div);
  });
  grid.querySelectorAll('button').forEach(b=>b.onclick=()=>acao(b.dataset.a, +b.dataset.i));
  $('#contagem').textContent=itens.filter(x=>!x.apagar).length+' foto(s)';
  $('#btn-salvar').disabled=false;
}

function acao(a,i){
  if(a==='capa'){ const [x]=itens.splice(i,1); itens.unshift(x); }
  else if(a==='esq' && i>0){ [itens[i-1],itens[i]]=[itens[i],itens[i-1]]; }
  else if(a==='dir' && i<itens.length-1){ [itens[i+1],itens[i]]=[itens[i],itens[i+1]]; }
  else if(a==='del'){ itens[i].apagar=!itens[i].apagar; }
  render();
}

$('#btn-add').onclick=async()=>{
  if(window.showOpenFilePicker){
    try{
      const handles=await window.showOpenFilePicker({multiple:true,types:[{description:'Imagens',accept:{'image/*':['.jpg','.jpeg','.png','.webp','.gif','.avif']}}]});
      for(const handle of handles){ await adicionarFoto(await handle.getFile()); }
    }catch(e){ if(e.name!=='AbortError') log('ERRO ao selecionar fotos: '+e.message); }
  }else $('#add-input').click();
};
$('#add-input').onchange=async(e)=>{
  for(const file of e.target.files) await adicionarFoto(file);
  e.target.value='';
  render();
};
async function adicionarFoto(file){
  const blob=await otimizar(file);
  let base=file.name.replace(/\.[^.]+$/,'').toLowerCase().replace(/[^a-z0-9-_]+/g,'-');
  const nome=base+'.jpg';
  const path='assets/passeios/'+pastaPasseio(atual)+'/'+nome;
  itens.push({path, nome, tipo:'local', url:URL.createObjectURL(blob), apagar:false, novaBlob:blob});
  render();
}

async function otimizar(file){
  const img=await createImageBitmap(file);
  let {width:w,height:h}=img;
  if(Math.max(w,h)>MAXPX){ const r=MAXPX/Math.max(w,h); w=Math.round(w*r); h=Math.round(h*r); }
  const c=document.createElement('canvas'); c.width=w; c.height=h;
  c.getContext('2d').drawImage(img,0,0,w,h);
  let q=Q0, blob=await new Promise(r=>c.toBlob(r,'image/jpeg',q));
  while(blob.size/1024>MAXKB && q>QMIN){ q-=0.06; blob=await new Promise(r=>c.toBlob(r,'image/jpeg',q)); }
  return blob;
}

$('#btn-salvar').onclick=async()=>{
  if(!atual) return;
  $('#btn-salvar').disabled=true; log('Salvando "'+atual+'"...');
  try{
    // 1) renumera e grava as fotos como <id>-1,2,3... (capa = -1) no site parceiro
    var pasta = pastaPasseio(atual);
    var kept = itens.filter(function(x){return !x.apagar;});
    var n=0;
    kept.forEach(function(it){
      if(it.tipo==='local'){ n++; it._novoNome=pasta+n+'.jpg'; it._novoPath='assets/passeios/'+pasta+'/'+it._novoNome; }
      else { it._novoPath=it.path; }
    });
    for(const s of sites){
      const d=await dirPasseio(s,atual,true);
      if(!d){ log('  '+s.nome+': passeio não existe nesse site, pulado.'); continue; }
      // le TODAS as fotos locais em memoria ANTES de gravar (evita corromper ao renumerar/trocar ordem)
      for(const it of kept){
        if(it.tipo!=='local') continue;
        if(it.novaBlob){ it._bytes=it.novaBlob; }
        else { try{ const fh=await d.getFileHandle(it.nome); it._bytes=await fh.getFile(); }catch(e){ it._bytes=null; log('  '+s.nome+': nao achei '+it.nome); } }
      }
      // grava cada foto ja com o nome final
      for(const it of kept){
        if(it.tipo!=='local' || !it._bytes) continue;
        const fh=await d.getFileHandle(it._novoNome,{create:true}); const w=await fh.createWritable(); await w.write(it._bytes); await w.close();
      }
      if(vidLocal){ const fh=await d.getFileHandle(vidLocal.nome,{create:true}); const w=await fh.createWritable(); await w.write(vidLocal.blob); await w.close(); }
      // apaga arquivos locais que NAO estao no conjunto final (nomes antigos, apagados, sobras, formatos velhos)
      var manter={}; kept.forEach(function(it){ if(it.tipo==='local') manter[it._novoNome]=1; });
      if(vidLocal) manter[vidLocal.nome]=1; else if(vidAtualLocal) manter[vidAtualLocal.split('/').pop()]=1;
      try{ for await(const [nm,h] of d.entries()){ if(h.kind==='file' && /\.(jpe?g|png|webp)$/i.test(nm) && !manter[nm]){ try{ await d.removeEntry(nm); }catch(e){} } } }catch(e){}
      log('  '+s.nome+': arquivos ok (renumerado '+n+' foto(s))');
    }
    // 2) reescreve o array imagens no data.js do site parceiro
    const finais=kept.map(function(x){return x._novoPath;});
    let vidoList=[];
    if(vidLocal){ vidoList=['assets/passeios/'+pastaPasseio(atual)+'/'+vidLocal.nome]; }
    else if($('#video-input').value.trim()){ const y=ytId($('#video-input').value); if(y) vidoList=['https://www.youtube.com/embed/'+y]; }
    else if(vidAtualLocal){ vidoList=[vidAtualLocal]; }
    for(const s of sites){
      let js; try{ js=await lerTexto(s.dir,'data.js'); }catch(e){ continue; }
      if(!getImagens(js,atual)){ log('  '+s.nome+'/data.js: passeio não existe, pulado.'); continue; }
      // backup
      const stamp=new Date().toISOString().replace(/[-:T]/g,'').slice(0,14);
      await escreverTexto(s.dir,'data.js.bak_admin_'+stamp, js);
      js=setImagens(js,atual,finais);
      js=setVideos(js,atual,vidoList);
      await escreverTexto(s.dir,'data.js', js);
      log('  '+s.nome+'/data.js: '+finais.length+' foto(s), vídeo: '+(vidoList[0]||'nenhum')+' (backup salvo)');
    }
    log('OK! Agora teste o site e faça commit+push no GitHub.');
    await selecionar(atual); // recarrega
  }catch(e){ log('ERRO: '+e.message); $('#btn-salvar').disabled=false; }
};
</script>
</body>
